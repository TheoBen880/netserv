{
  "nodes": {
    "browser": {
      "name": "Browser",
      "data": {
        "UI Branch": { "type": "Text Input", "value": "web/" }
      }
    },
    "authRouter": {
      "name": "Auth router",
      "data": {
        "Mount": { "type": "Text Input", "value": "/auth" },
        "Routes": { "type": "Tag Input", "value": ["GET /init", "POST /login"] }
      }
    },
    "login": {
      "name": "Login handler",
      "type": "shape",
      "shape": "diamond",
      "data": {
        "Source": { "type": "Text Input", "value": "server/web/controller/auth.ts" },
        "Equality": { "type": "Text Input", "value": "Direct comparison with configured password" }
      }
    },
    "login401": {
      "name": "401 Invalid password",
      "data": {
        "Also Returns": { "type": "Text Input", "value": "400 when no password or login disabled" }
      }
    },
    "issue": {
      "name": "Issue session",
      "data": {
        "Token": { "type": "Text Input", "value": "JWT expiresIn 1h" },
        "Cookie": { "type": "Text Input", "value": "jwt, httpOnly, maxAge 1 year" }
      }
    },
    "init": {
      "name": "Init handler",
      "type": "shape",
      "shape": "diamond",
      "data": {
        "Response": { "type": "Text Input", "value": "writable, authEnabled, jwt" },
        "Bypass": { "type": "Text Input", "value": "jwt null when login disabled" }
      }
    },
    "rotate": {
      "name": "Rotate session",
      "data": {
        "Behavior": { "type": "Text Input", "value": "Fresh token and reset cookie" }
      }
    },
    "clear": {
      "name": "Clear session",
      "data": {
        "Behavior": { "type": "Text Input", "value": "Clears cookie, reports jwt null" }
      }
    },
    "guard": {
      "name": "Auth gate",
      "type": "shape",
      "shape": "diamond",
      "data": {
        "Source": { "type": "Text Input", "value": "checkAuthMiddleware in controller/auth.ts" },
        "Rejection": { "type": "Text Input", "value": "401 without a valid JWT cookie" }
      }
    },
    "open": {
      "name": "Password mode off",
      "data": {
        "Behavior": { "type": "Text Input", "value": "Requests pass and routes stay open" }
      }
    },
    "guard401": {
      "name": "401 No/invalid JWT",
      "data": {
        "Cookie State": { "type": "Text Input", "value": "Absent or failed verification" }
      }
    },
    "api": {
      "name": "API router",
      "data": {
        "Mount": { "type": "Text Input", "value": "/api" },
        "Routes": { "type": "Tag Input", "value": ["dir", "file", "rename", "delete", "new-folder", "upload"] }
      }
    }
  },
  "edges": {
    "login-login401": { "label": "empty or wrong" },
    "login-issue": { "label": "correct" },
    "init-rotate": { "label": "valid cookie" },
    "init-clear": { "label": "invalid" },
    "guard-open": { "label": "password mode off" },
    "guard-guard401": { "label": "no or invalid cookie" },
    "guard-api": { "label": "valid" }
  }
}
